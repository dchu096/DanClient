<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="Window.launcher">
    <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="#F0F0F0" />
    <Setter Property="Background" Value="#0C0C0C" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="Background" Value="#242424" />
    <Setter Property="BorderBrush" Value="#383838" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#F0F0F0" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="#2E2E2E" />
    <Setter Property="BorderBrush" Value="#484848" />
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <Style Selector="Button.chrome">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
  </Style>
  <Style Selector="Button.chrome:pointerover">
    <Setter Property="Background" Value="#242424" />
  </Style>
  <Style Selector="Button.chromeClose:pointerover">
    <Setter Property="Background" Value="#E81123" />
  </Style>

  <Style Selector="Button.navItem">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Foreground" Value="#999999" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.navItem:pointerover">
    <Setter Property="Background" Value="#1A1A1A" />
    <Setter Property="Foreground" Value="#E0E0E0" />
  </Style>
  <Style Selector="Button.navItem.active">
    <Setter Property="Background" Value="#1E2A18" />
    <Setter Property="Foreground" Value="#82C35D" />
  </Style>

  <Style Selector="Button.playButton">
    <Setter Property="MinWidth" Value="200" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="32,12" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="2" />
    <Setter Property="Background" Value="#62A035" />
    <Setter Property="Foreground" Value="#FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Button.playButton:pointerover">
    <Setter Property="Background" Value="#72B842" />
  </Style>

  <Style Selector="Button.linkButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="#82C35D" />
    <Setter Property="Padding" Value="0,4" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.linkButton:pointerover">
    <Setter Property="Foreground" Value="#A0E070" />
  </Style>

  <Style Selector="Button.compact">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Background" Value="#1A1A1A" />
    <Setter Property="BorderBrush" Value="#333333" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="MinWidth" Value="160" />
    <Setter Property="Background" Value="#161616" />
    <Setter Property="BorderBrush" Value="#333333" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#F0F0F0" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ComboBox.compact">
    <Setter Property="MinWidth" Value="140" />
    <Setter Property="MinHeight" Value="36" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Background" Value="#161616" />
    <Setter Property="BorderBrush" Value="#333333" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#F0F0F0" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Background" Value="#161616" />
    <Setter Property="BorderBrush" Value="#333333" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#F0F0F0" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="#BBBBBB" />
  </Style>
  <Style Selector="ToggleSwitch">
    <Setter Property="Foreground" Value="#BBBBBB" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="#62A035" />
    <Setter Property="Background" Value="#242424" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="MinHeight" Value="3" />
    <Setter Property="MaxHeight" Value="3" />
  </Style>
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.titleBar">
    <Setter Property="Background" Value="#0A0A0A" />
    <Setter Property="BorderBrush" Value="#222222" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="#101010" />
    <Setter Property="BorderBrush" Value="#222222" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="Border.playDock">
    <Setter Property="Background" Value="#141414" />
    <Setter Property="BorderBrush" Value="#222222" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="24,16" />
  </Style>
  <Style Selector="Border.statusStrip">
    <Setter Property="Background" Value="#0A0A0A" />
    <Setter Property="BorderBrush" Value="#222222" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="20,6" />
  </Style>
  <Style Selector="Border.fieldDisplay">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Background" Value="#161616" />
    <Setter Property="BorderBrush" Value="#333333" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="#161616" />
    <Setter Property="BorderBrush" Value="#282828" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="20" />
  </Style>
  <Style Selector="Border.codeBox">
    <Setter Property="Background" Value="#0E1A0A" />
    <Setter Property="BorderBrush" Value="#2A3A1A" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#666666" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="#888888" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#666666" />
  </Style>
  <Style Selector="TextBlock.statusText">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="#555555" />
  </Style>
</Styles>
